# === LLM Provider ===
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
SMALL_MODEL=llama-3.1-8b-instant
LARGE_MODEL=llama-3.3-70b-versatile

# === Fallback LLM Provider (optional) ===
FALLBACK_LLM_BASE_URL=
FALLBACK_LLM_API_KEY=
FALLBACK_LARGE_MODEL=

# === Tool API Keys ===
TAVILY_API_KEY=
GITHUB_TOKEN=                     # optional, raises GitHub rate limit

# === Budgets ===
MAX_SUBQUESTIONS=5
MAX_SEARCH_CALLS=10
MAX_FETCHES=12
MAX_LLM_CALLS=30
MAX_REPLANS=1
RUN_TIMEOUT_S=120
TOOL_TIMEOUT_S=10
FETCH_MAX_BYTES=1500000

# === Feature Flags ===
ENABLE_JUDGE=false
CHAOS_MODE=off                    # off | search_down | timeout | malformed | injection | empty

